{
  "version": "2.0",
  "functionTimeout": "00:05:00",
  "extensionBundle": {"id": "Microsoft.Azure.Functions.ExtensionBundle", "version": "[4.0.0, 5.0.0)"},
  "extensions": {
    "http": {"routePrefix": "", "maxOutstandingRequests": 100, "maxConcurrentRequests": 20},
